# ==============================================================================
# Full-Stack Application Environment Configuration (.env)
# Shared across Vue 3 Frontend, Express API, Drizzle ORM, and Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
# Port where the Express API server listens
BACKEND_PORT=3000
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Frontend Server Configuration
# ------------------------------------------------------------------------------
# Port where Vite development server or frontend container runs
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# Bidirectional Port & CORS Pairing
# ------------------------------------------------------------------------------
# CORS Origin: Backend automatically permits requests from this origin
# (Defaults to http://localhost:${FRONTEND_PORT})
CORS_ORIGIN=http://localhost:5173

# Frontend API URL:
# - Leave empty or default in development: Vite proxies /api requests to http://localhost:${BACKEND_PORT}
# - For explicit direct cross-origin API calls from the client, set this to the backend URL
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
# Individual MySQL database parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=express_drizzle_db

# Complete MySQL Connection String for Drizzle ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# (Used by drizzle-kit and backend MySQL connection pool)
DATABASE_URL="mysql://root:password@localhost:3306/express_drizzle_db"

